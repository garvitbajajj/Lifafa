# Copy to .env and fill in. .env is gitignored - never commit a real connection string or token.

# Any PostgreSQL. For Supabase: Project settings -> Database -> Connection string -> URI,
# and replace [YOUR-PASSWORD] with the database password.
#   postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres
# Behind IPv4-only networks use the session pooler string Supabase shows on the same page.
# Not needed with Docker Compose, which runs its own PostgreSQL.
DATABASE_URL=

# Lifafa keeps its tables in their own schema, so it can share a database with other projects.
DB_SCHEMA=lifafa

# Required outside demo mode: at least 24 characters. Generate one with
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
LIFAFA_ADMIN_TOKEN=

# The port the service listens on.
PORT=3100

# Docker Compose only: the password of the PostgreSQL it runs.
LIFAFA_DB_PASSWORD=lifafa
